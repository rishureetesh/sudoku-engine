{
  "name": "@reetesh/sudoku-engine",
  "version": "1.0.0",
  "description": "Sudoku generator and solver for TypeScript",
  "license": "MIT",
  "author": "Reetesh Kumar (https://github.com/rishureetesh)",
  "homepage": "https://github.com/rishureetesh/sudoku-engine#readme",
  "bugs": {
    "url": "https://github.com/rishureetesh/sudoku-engine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rishureetesh/sudoku-engine.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./sudoku": {
      "import": {
        "types": "./dist/sudoku.d.ts",
        "default": "./dist/sudoku.js"
      },
      "require": {
        "types": "./dist/sudoku.d.cts",
        "default": "./dist/sudoku.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "sudoku",
    "puzzle",
    "generator",
    "solver",
    "difficulty",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vitest": "^3.1.4"
  }
}
